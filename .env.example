# Copy to .env and fill in. Never commit .env.
# Only the key of the `provider` set in config/llm.yaml is needed.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# live (default): real API calls to the provider in config/llm.yaml
# mock:   answer from saved fixtures in evals/fixtures/, no key needed, no cost
# record: real API calls, and save each answer as a fixture for mock mode
FACTFIT_LLM_MODE=live

# Profile used by the API and UI (default data/profile.yaml). Point it at the example
# profile to try the app before your own profile validates.
# FACTFIT_PROFILE=data/profile.example.yaml
