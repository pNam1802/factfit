{
  "openapi": "3.1.0",
  "info": {
    "title": "factfit",
    "description": "Tailor CVs without inventing.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/jobs": {
      "post": {
        "summary": "Create Job",
        "description": "Paste a job description: it is parsed into requirements (cached per text).",
        "operationId": "create_job_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateJob"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "summary": "Get Job",
        "operationId": "get_job_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}/match": {
      "post": {
        "summary": "Match",
        "description": "Check the profile against a parsed job: status and evidence per requirement.",
        "operationId": "match_jobs__job_id__match_post",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Job Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/MatchRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchOut"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Bad Gateway"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateJob": {
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text",
            "description": "The job description, pasted as text"
          },
          "company": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "CreateJob"
      },
      "ErrorOut": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "issues": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Issues",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorOut"
      },
      "Evidence": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "where": {
            "type": "string",
            "title": "Where"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "id",
          "where",
          "text"
        ],
        "title": "Evidence"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobDescription": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "company": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company"
          },
          "seniority": {
            "type": "string",
            "enum": [
              "intern",
              "fresher",
              "junior",
              "mid",
              "senior",
              "unknown"
            ],
            "title": "Seniority"
          },
          "language": {
            "type": "string",
            "enum": [
              "vi",
              "en"
            ],
            "title": "Language"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "must_have": {
            "items": {
              "$ref": "#/components/schemas/Requirement"
            },
            "type": "array",
            "title": "Must Have"
          },
          "nice_to_have": {
            "items": {
              "$ref": "#/components/schemas/Requirement"
            },
            "type": "array",
            "title": "Nice To Have"
          },
          "responsibilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Responsibilities"
          },
          "keywords": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Keywords"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "company",
          "seniority",
          "language",
          "location",
          "must_have",
          "nice_to_have",
          "responsibilities",
          "keywords"
        ],
        "title": "JobDescription"
      },
      "JobOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "company": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company"
          },
          "cached": {
            "type": "boolean",
            "title": "Cached"
          },
          "jd": {
            "$ref": "#/components/schemas/JobDescription"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "company",
          "cached",
          "jd"
        ],
        "title": "JobOut"
      },
      "MatchOut": {
        "properties": {
          "job_id": {
            "type": "integer",
            "title": "Job Id"
          },
          "score": {
            "type": "integer",
            "title": "Score"
          },
          "level": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "intern",
                  "fresher",
                  "junior",
                  "mid",
                  "senior",
                  "unknown"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Level"
          },
          "profile_version": {
            "type": "string",
            "title": "Profile Version"
          },
          "cached": {
            "type": "boolean",
            "title": "Cached"
          },
          "requirements": {
            "items": {
              "$ref": "#/components/schemas/RequirementOut"
            },
            "type": "array",
            "title": "Requirements"
          },
          "excluded": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Excluded"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "score",
          "level",
          "profile_version",
          "cached",
          "requirements",
          "excluded"
        ],
        "title": "MatchOut"
      },
      "MatchRequest": {
        "properties": {
          "level": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "intern",
                  "fresher",
                  "junior",
                  "mid",
                  "senior",
                  "unknown"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Level",
            "description": "Applicant level for postings that hire several; default: lowest accepted"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "MatchRequest"
      },
      "Requirement": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "category": {
            "type": "string",
            "enum": [
              "skill",
              "experience",
              "education",
              "language",
              "soft_skill",
              "other"
            ],
            "title": "Category"
          },
          "any_of": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Any Of"
          },
          "level": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "intern",
                  "fresher",
                  "junior",
                  "mid",
                  "senior",
                  "unknown"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Level"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "text",
          "category",
          "any_of",
          "level"
        ],
        "title": "Requirement"
      },
      "RequirementOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "bucket": {
            "type": "string",
            "enum": [
              "must",
              "nice"
            ],
            "title": "Bucket"
          },
          "category": {
            "type": "string",
            "enum": [
              "skill",
              "experience",
              "education",
              "language",
              "soft_skill",
              "other"
            ],
            "title": "Category"
          },
          "any_of": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Any Of"
          },
          "status": {
            "type": "string",
            "enum": [
              "met",
              "partial",
              "missing",
              "unverifiable"
            ],
            "title": "Status"
          },
          "note": {
            "type": "string",
            "title": "Note"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          }
        },
        "type": "object",
        "required": [
          "id",
          "text",
          "bucket",
          "category",
          "any_of",
          "status",
          "note",
          "evidence"
        ],
        "title": "RequirementOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
