<#
  CV template for factfit, from the author's Overleaf CV, itself based on Jake's Resume
  (https://github.com/sb2nov/resume, MIT). Layout and commands are unchanged; content comes
  from factfit.render.view, already escaped.
  Jinja markers are changed so they do not clash with LaTeX braces: double angle brackets
  for values, angle bracket + percent for statements, angle bracket + hash for comments
  (see factfit/render/compile.py). Do not write the closing comment marker in a comment.
#>
%-------------------------
% Resume in Latex
% Based on: https://github.com/sb2nov/resume and https://www.overleaf.com/latex/templates/jakes-resume/syzfjbzwjncs
% License : MIT
% Generated by factfit (https://github.com/pNam1802/factfit)
%------------------------

\documentclass[letterpaper,11pt]{article}

\usepackage{latexsym}
\usepackage[empty]{fullpage}
\usepackage{titlesec}
\usepackage{marvosym}
\usepackage[usenames,dvipsnames]{color}
\usepackage{verbatim}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{fancyhdr}
\usepackage[english]{babel}
\usepackage{tabularx}
\usepackage{iftex}

% Machine-readable PDF text for ATS. These two lines exist only in pdfLaTeX (Overleaf's
% default); factfit compiles with tectonic (XeTeX), which skips them.
\ifPDFTeX
  \input{glyphtounicode}
  \pdfgentounicode=1
\fi

\pagestyle{fancy}
\fancyhf{} % clear all header and footer fields
\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% Adjust margins
\addtolength{\oddsidemargin}{-0.5in}
\addtolength{\evensidemargin}{-0.5in}
\addtolength{\textwidth}{1in}
\addtolength{\topmargin}{-.7in}
\addtolength{\textheight}{1.4in}

\urlstyle{same}

\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}

% Sections formatting
\titleformat{\section}{
  \vspace{-4pt}\scshape\raggedright\large
}{}{0em}{}[\color{black}\titlerule \vspace{-5pt}]

%-------------------------
% Custom commands
\newcommand{\resumeItem}[1]{
  \item\small{
    {#1 \vspace{-2pt}}
  }
}

\newcommand{\resumeSubheading}[4]{
  \vspace{-2pt}\item
    \begin{tabular*}{0.97\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & #2 \\
      \textit{\small#3} & \textit{\small #4} \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeProjectHeading}[2]{
    \item
    \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
      \small#1 & #2 \\
    \end{tabular*}\vspace{-7pt}
}

\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.15in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-5pt}}

%-------------------------------------------
\begin{document}

%----------HEADING----------
\begin{center}
    \textbf{\Huge \scshape << cv.name >>} \\ \vspace{1pt}
<% if cv.headline %>
    \small \textit{<< cv.headline >>} \\
<% endif %>
    << cv.contact >>
\end{center}
<% if cv.summary %>

%-----------SUMMARY-----------
\section*{Summary}
<< cv.summary >>
<% endif %>
<% if cv.skill_groups %>

%-----------TECHNICAL SKILLS-----------
\section{Technical Skills}
 \begin{itemize}[leftmargin=0.15in, label={}]
    \small{\item{
<% for heading, skills in cv.skill_groups %>
     \textbf{<< heading >>}{: << skills >>} \\
<% endfor %>
    }}
 \end{itemize}
<% endif %>
<% if cv.experiences %>

%-----------EXPERIENCE-----------
\section{Experience}
  \resumeSubHeadingListStart
<% for e in cv.experiences %>

    \resumeSubheading
      {<< e.title >>}{<< e.dates >>}
      {<< e.subtitle >>}{<< e.place >>}
<% if e.bullets %>
      \resumeItemListStart
<% for b in e.bullets %>
        \resumeItem{<< b >>}
<% endfor %>
      \resumeItemListEnd
<% endif %>
<% endfor %>

  \resumeSubHeadingListEnd
<% endif %>
<% if cv.projects %>

%-----------PROJECTS-----------
\section{Projects}
   \resumeSubHeadingListStart
<% for p in cv.projects %>
     \resumeProjectHeading
         {<< p.title >>}{<< p.dates >>}
<% if p.bullets %>
         \resumeItemListStart
<% for b in p.bullets %>
           \resumeItem{<< b >>}
<% endfor %>
         \resumeItemListEnd
<% endif %>
<% endfor %>
   \resumeSubHeadingListEnd
<% endif %>
<% if cv.education %>

%-----------EDUCATION-----------
\section{Education}
  \resumeSubHeadingListStart
<% for ed in cv.education %>
    \resumeSubheading
      {<< ed.title >>}{<< ed.place >>}
      {<< ed.subtitle >>}{<< ed.dates >>}
<% endfor %>
  \resumeSubHeadingListEnd
<% endif %>
<% if cv.certifications %>

%-----------CERTIFICATIONS-----------
\section{Certifications}
  \begin{itemize}[leftmargin=0.15in, label={}]
    \small{\item{
     << cv.certifications >>
    }}
 \end{itemize}
<% endif %>

%-------------------------------------------
\end{document}
